APP_NAME="WIPS Storage"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=warning
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
CORS_ALLOWED_ORIGINS=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rose_storage
DB_USERNAME=root
DB_PASSWORD=

FILESYSTEM_DISK=local
BACKUP_ENABLED=true
BACKUP_ZIP_PASSWORD=
BACKUP_ADMIN_USER_IDS=
BACKUP_GOOGLE_DRIVE_FOLDER_ID=
BACKUP_MYSQL_DUMP_BINARY=mysqldump
BACKUP_TIMEOUT=300
BACKUP_BATCH_SIZE=0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
STORAGE_MAX_UPLOAD_MB=50
PRIVATE_URL_MAX_SECONDS=86400
SANCTUM_STATEFUL_DOMAINS=localhost
SANCTUM_DEFAULT_TOKEN_MINUTES=1440
SANCTUM_TOKEN_MAX_SECONDS=31536000
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMeNow!123
